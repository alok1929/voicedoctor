# ============================================
# Evals Caller Server — environment config
# Copy to .env and fill in. .env is gitignored.
# ============================================

# === Vobiz telephony (the evals agent's outbound account) ===
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token
VOBIZ_API_BASE=https://api.vobiz.ai/api/v1
# The evals agent's own number, used as the outbound caller ID (`from`).
VOBIZ_CALLER_ID=+910000000000

# === Provider API keys (the evals agent's STT/LLM/TTS) ===
DEEPGRAM_API_KEY=your-deepgram-key
OPENAI_API_KEY=your-openai-key
CARTESIA_API_KEY=your-cartesia-key

# === Public URLs (Cloudflare Tunnel on AWS) ===
PUBLIC_HTTPS_URL=https://evalsra-api.framewise.ai
PUBLIC_WSS_URL=wss://evalsra-api.framewise.ai

# === Audio / call settings ===
# 8000 -> mu-law, 16000 -> L16 raw PCM. Start with 8000.
SAMPLE_RATE=8000
SESSION_TIMEOUT_MINUTES=3

# === Optional model overrides ===
# OPENAI_MODEL=gpt-4o-mini
# DEEPGRAM_MODEL=nova-2
# DEEPGRAM_LANGUAGE=en-IN
# CARTESIA_MODEL=sonic-2
# CARTESIA_VOICE_ID=794f9389-aac1-45b6-b726-9d9369183238
